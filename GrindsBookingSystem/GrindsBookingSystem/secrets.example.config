<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to secrets.config (same folder) and fill in your own details.
  secrets.config is listed in .gitignore, so your passwords are never committed.
-->
<appSettings>
  <!-- Oracle database: host:port/service name -->
  <add key="OracleDataSource" value="studentoracle:1521/orcl" />
  <add key="OracleUserId" value="" />
  <add key="OraclePassword" value="" />

  <!-- Optional: Gmail account used to send booking confirmation emails.
       Use a Gmail App Password (Google Account > Security > App passwords), not your normal password. -->
  <add key="GmailAddress" value="" />
  <add key="GmailAppPassword" value="" />
</appSettings>
